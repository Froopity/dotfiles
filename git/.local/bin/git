#!/usr/bin/env bash
# Shadows /usr/bin/git on PATH. Under /mnt/c/* paths, Linux git is
# painfully slow, so use git.exe there -- except for flags that return a
# filesystem path, since git.exe returns it Windows-style (C:/...).
case "$*" in
  *--show-toplevel*|*--show-cdup*|*--absolute-git-dir*|*--git-dir*|*--git-common-dir*|*--show-superproject-working-tree*)
    exec /usr/bin/git "$@" ;;
esac

# pwd -P, not $PWD: a chdir()ing caller that doesn't re-export it (e.g.
# Neovim jobs) leaves it stale.
if [[ "$(pwd -P)" == /mnt/c/* ]]; then
  # git.exe's global core.autocrlf=true smudges LF->CRLF on show/diff output,
  # which desyncs from WSL git's LF-only blobs and breaks tools (gitsigns)
  # that byte-match diff output against buffer content. Force it off here so
  # git.exe is a transparent, faster substitute for /usr/bin/git.
  exec git.exe -c core.autocrlf=false "$@"
fi
exec /usr/bin/git "$@"
